# Default local environment for Zest.
# Production servers can replace this file, or set ENV_FILE to another path.
APP_ENV=development
APP_BASE_URL=http://localhost:8765
APP_ADDR=:8765
DATABASE_PATH=./data/app.db
SESSION_SECRET=dev-secret-change-me
UNDO_WINDOW_SECONDS=20
COMMON_AMOUNTS=10,20,40,60
SEED_ADMIN_EMAIL=admin@example.com
SEED_USER_EMAIL=user@example.com

# Auth0 OIDC configuration. Replace placeholders in real environments.
AUTH0_DOMAIN=
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:8765/auth/callback
AUTH0_LOGOUT_RETURN_URL=http://localhost:8765/login
ALLOWED_EMAILS=
ADMIN_EMAILS=
DEFAULT_ORG_ID=org_dev
